<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>HwpxAgent.WindowsWorker.StaSmoke</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/HwpxAgent.WindowsWorker/HwpxAgent.WindowsWorker.csproj" />
    <ProjectReference Include="../../src/HwpxAgent.WindowsWorker.Host/HwpxAgent.WindowsWorker.Host.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyStaHost" AfterTargets="Build">
    <ItemGroup>
      <StaHostArtifacts Include="$(MSBuildProjectDirectory)/../../src/HwpxAgent.WindowsWorker.Host/bin/$(Configuration)/net10.0-windows/*" />
    </ItemGroup>
    <Copy SourceFiles="@(StaHostArtifacts)" DestinationFolder="$(OutDir)/sta-host" />
  </Target>
</Project>
