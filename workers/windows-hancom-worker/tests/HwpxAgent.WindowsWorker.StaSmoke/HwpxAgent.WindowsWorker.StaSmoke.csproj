<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>HwpxAgent.WindowsWorker.StaSmoke</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/HwpxAgent.WindowsWorker/HwpxAgent.WindowsWorker.csproj" />
    <ProjectReference Include="../HwpxAgent.WindowsWorker.TestHost/HwpxAgent.WindowsWorker.TestHost.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyStaTestHost" AfterTargets="Build">
    <ItemGroup>
      <StaTestHostArtifacts Include="$(MSBuildProjectDirectory)/../HwpxAgent.WindowsWorker.TestHost/bin/$(Configuration)/net10.0-windows/*" />
    </ItemGroup>
    <Copy SourceFiles="@(StaTestHostArtifacts)" DestinationFolder="$(OutDir)/sta-test-host" />
  </Target>
</Project>
