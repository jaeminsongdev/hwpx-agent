{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwpx-agent.local/schemas/error-envelope.schema.json",
  "title": "ErrorEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "error_code",
    "category",
    "safe_message",
    "retryable",
    "stage",
    "details",
    "recovery"
  ],
  "properties": {
    "schema_version": {
      "const": "hwpx-agent.error/v2"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "error_code": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Z][A-Z0-9_]+$"
    },
    "category": {
      "enum": [
        "input",
        "capability",
        "conflict",
        "document",
        "security",
        "backend",
        "validation",
        "storage",
        "external",
        "internal"
      ]
    },
    "safe_message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[ -~]+$"
    },
    "retryable": {
      "type": "boolean"
    },
    "stage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "details": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "allOf": [
          {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          {
            "not": {
              "enum": [
                "access_token",
                "authorization",
                "bearer",
                "document_content",
                "internal_trace_id",
                "local_path",
                "password",
                "raw_error",
                "secret",
                "signed_url",
                "stack_trace",
                "subject_digest",
                "tenant_id"
              ]
            }
          }
        ]
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean",
          "null"
        ]
      }
    },
    "recovery": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "params": {
            "type": "object",
            "maxProperties": 8,
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "integer",
                "boolean",
                "null"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "internal_trace_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    }
  }
}
