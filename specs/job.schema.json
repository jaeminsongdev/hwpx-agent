{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwpx-agent.local/schemas/job.schema.json",
  "title": "Job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "state",
    "stages",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "hwpx-agent.job/v2"
    },
    "job_id": {
      "type": "string",
      "pattern": "^job_"
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "request_id": {
      "type": "string"
    },
    "state": {
      "enum": [
        "queued",
        "leasing",
        "running",
        "validating",
        "committing",
        "succeeded",
        "failed",
        "cancelled",
        "expired",
        "quarantined"
      ]
    },
    "current_stage": {
      "type": [
        "string",
        "null"
      ]
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage_id",
          "state"
        ],
        "properties": {
          "stage_id": {
            "type": "string"
          },
          "state": {
            "enum": [
              "pending",
              "running",
              "succeeded",
              "failed",
              "cancelled",
              "skipped"
            ]
          },
          "attempt": {
            "type": "integer",
            "minimum": 0
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "worker_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "input_hash": {
            "type": [
              "string",
              "null"
            ]
          },
          "output_artifact_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "error": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": true
    },
    "result": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "cancel_requested": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
