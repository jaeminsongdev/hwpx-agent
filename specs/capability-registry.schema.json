{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwpx-agent.local/schemas/capability-registry.schema.json",
  "title": "CapabilityRegistry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_version",
    "generated_at",
    "source_lock_id",
    "target_profiles",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": "hwpx-agent.capability-registry/v2"
    },
    "registry_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_lock_id": {
      "type": "string"
    },
    "target_profiles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      }
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "title_ko",
        "scope_class",
        "operation_schema_ref",
        "permission",
        "risk",
        "support_disposition",
        "bindings",
        "validation_contract"
      ],
      "properties": {
        "capability_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]+$"
        },
        "feature_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "title_ko": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "scope_class": {
          "type": "string"
        },
        "operation_schema_ref": {
          "type": "string"
        },
        "permission": {
          "type": "string"
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "support_disposition": {
          "enum": [
            "DIRECT_FULL",
            "AUTOMATION_FULL",
            "HYBRID",
            "READ_ONLY",
            "PRESERVE_ONLY",
            "OPTIONAL_EXTERNAL",
            "DISABLED_BY_POLICY",
            "UNSUPPORTED"
          ]
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "validation_contract": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": true
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "release_state_by_target": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "candidate",
              "bound",
              "unit_passed",
              "integration_passed",
              "oracle_verified",
              "release_enabled",
              "disabled",
              "unverified_for_build"
            ]
          }
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "backend",
        "target_profile",
        "status",
        "implementation"
      ],
      "properties": {
        "binding_id": {
          "type": "string"
        },
        "backend": {
          "enum": [
            "direct_hwpx",
            "desktop_automation",
            "webhwp",
            "external_connector"
          ]
        },
        "target_profile": {
          "type": "string"
        },
        "status": {
          "enum": [
            "candidate",
            "verified_binding",
            "deprecated",
            "disabled"
          ]
        },
        "implementation": {
          "type": "object",
          "additionalProperties": true
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "postconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "known_issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_checksum": {
          "type": [
            "string",
            "null"
          ]
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}
