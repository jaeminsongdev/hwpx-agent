{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwpx-agent.local/schemas/document-graph-v2.schema.json",
  "title": "DocumentGraph v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "metadata",
    "settings",
    "resource_catalog",
    "style_catalog",
    "sections"
  ],
  "properties": {
    "schema_version": {
      "const": "hwpx-agent.document-graph/v2"
    },
    "document_id": {
      "type": "string"
    },
    "source_profile": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "settings": {
      "type": "object",
      "additionalProperties": true
    },
    "security_state": {
      "type": "object",
      "additionalProperties": true
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": true
    },
    "resource_catalog": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "style_catalog": {
      "$ref": "style-v2.schema.json"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "notes": {
      "type": "object",
      "additionalProperties": true
    },
    "references": {
      "type": "object",
      "additionalProperties": true
    },
    "review": {
      "type": "object",
      "additionalProperties": true
    },
    "opaque_preservation_bag": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "required": [
        "resource_id",
        "kind"
      ],
      "properties": {
        "resource_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "image",
            "ole",
            "media",
            "font",
            "chart_data",
            "xml",
            "other"
          ]
        },
        "artifact_ref": {
          "$ref": "artifact-ref.schema.json"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "required": [
        "section_id",
        "properties",
        "body"
      ],
      "properties": {
        "section_id": {
          "type": "string"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true
        },
        "master_pages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "headers_footers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "body": {
          "$ref": "#/$defs/flow"
        }
      },
      "additionalProperties": false
    },
    "flow": {
      "type": "object",
      "required": [
        "children"
      ],
      "properties": {
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      },
      "additionalProperties": false
    },
    "node": {
      "oneOf": [
        {
          "$ref": "#/$defs/paragraph"
        },
        {
          "$ref": "#/$defs/table"
        },
        {
          "$ref": "#/$defs/equation"
        },
        {
          "$ref": "#/$defs/drawing"
        },
        {
          "$ref": "#/$defs/chart"
        },
        {
          "$ref": "#/$defs/field"
        },
        {
          "$ref": "#/$defs/form"
        },
        {
          "$ref": "#/$defs/break"
        },
        {
          "$ref": "#/$defs/embedded"
        }
      ]
    },
    "base": {
      "type": "object",
      "required": [
        "node_id",
        "node_type"
      ],
      "properties": {
        "node_id": {
          "type": "string"
        },
        "node_type": {
          "type": "string"
        },
        "source_anchor": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "style_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "layout_hints": {
          "type": "object",
          "additionalProperties": true
        },
        "semantics": {
          "type": "object",
          "additionalProperties": true
        },
        "provenance": {
          "type": "object",
          "additionalProperties": true
        },
        "preserve": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "paragraph": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "inlines"
          ],
          "properties": {
            "node_type": {
              "const": "paragraph"
            },
            "inlines": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "inline_type"
                ],
                "properties": {
                  "inline_type": {
                    "enum": [
                      "text",
                      "inline_equation",
                      "tab",
                      "line_break",
                      "field_ref",
                      "bookmark_anchor",
                      "change_span",
                      "control_ref"
                    ]
                  },
                  "text": {
                    "type": "string"
                  },
                  "properties": {
                    "type": "object",
                    "additionalProperties": true
                  }
                },
                "additionalProperties": true
              }
            },
            "paragraph_properties": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "table": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "rows",
            "columns",
            "cells"
          ],
          "properties": {
            "node_type": {
              "const": "table"
            },
            "rows": {
              "type": "integer",
              "minimum": 1
            },
            "columns": {
              "type": "integer",
              "minimum": 1
            },
            "cells": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "cell_id",
                  "row",
                  "column",
                  "row_span",
                  "column_span",
                  "content"
                ],
                "properties": {
                  "cell_id": {
                    "type": "string"
                  },
                  "row": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "column": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "row_span": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "column_span": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "content": {
                    "$ref": "#/$defs/flow"
                  },
                  "properties": {
                    "type": "object",
                    "additionalProperties": true
                  }
                },
                "additionalProperties": false
              }
            },
            "table_properties": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "equation": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "math_ast"
          ],
          "properties": {
            "node_type": {
              "const": "equation"
            },
            "math_ast": {
              "type": "object",
              "additionalProperties": true
            },
            "eqedit_script": {
              "type": [
                "string",
                "null"
              ]
            },
            "display": {
              "enum": [
                "inline",
                "display"
              ]
            },
            "equation_properties": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "drawing": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "properties": {
            "node_type": {
              "enum": [
                "image",
                "shape",
                "textbox",
                "drawing_group"
              ]
            },
            "drawing_properties": {
              "type": "object",
              "additionalProperties": true
            },
            "resource_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          }
        }
      ]
    },
    "chart": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "properties": {
            "node_type": {
              "const": "chart"
            },
            "chart_model": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "field": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "properties": {
            "node_type": {
              "const": "field"
            },
            "field_kind": {
              "type": "string"
            },
            "field_properties": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "form": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "properties": {
            "node_type": {
              "const": "form_control"
            },
            "control_kind": {
              "type": "string"
            },
            "control_properties": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "break": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "properties": {
            "node_type": {
              "enum": [
                "page_break",
                "column_break",
                "section_break"
              ]
            }
          }
        }
      ]
    },
    "embedded": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "properties": {
            "node_type": {
              "const": "embedded_object"
            },
            "resource_ref": {
              "type": "string"
            },
            "execution_policy": {
              "enum": [
                "preserve_only",
                "disabled",
                "allowlisted"
              ]
            }
          }
        }
      ]
    }
  }
}
