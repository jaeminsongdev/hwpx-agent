{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwpx-agent.local/schemas/operation-plan-v2.schema.json",
  "title": "OperationPlan v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "mode",
    "operations"
  ],
  "properties": {
    "schema_version": {
      "const": "hwpx-agent.operation-plan/v2"
    },
    "plan_id": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "normalized_authoring",
        "surgical_preserve",
        "native_automation"
      ]
    },
    "target_profile": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_revision_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "template_contract_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "postconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preservation": {
      "type": "object",
      "properties": {
        "untouched_parts": {
          "enum": [
            "byte_preserve",
            "token_preserve",
            "semantic_preserve",
            "not_required"
          ]
        },
        "unknown_xml": {
          "enum": [
            "preserve",
            "reject",
            "drop_explicitly"
          ]
        },
        "styles": {
          "enum": [
            "no_gc",
            "safe_gc",
            "normalize"
          ]
        }
      },
      "additionalProperties": true
    },
    "requested_validation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "selector": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "node_id": {
          "type": "string"
        },
        "node_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "section_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "range": {
          "type": "object",
          "additionalProperties": true
        },
        "query": {
          "type": "object",
          "additionalProperties": true
        },
        "field_name": {
          "type": "string"
        },
        "table_id": {
          "type": "string"
        },
        "paragraph_id": {
          "type": "string"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "after_node_id": {
          "type": "string"
        },
        "before_node_id": {
          "type": "string"
        },
        "cell_range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            }
          }
        },
        "row_indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "column_indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "equation_id": {
          "type": "string"
        },
        "equation_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "object_id": {
          "type": "string"
        },
        "object_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "control_id": {
          "type": "string"
        },
        "reference_id": {
          "type": "string"
        },
        "comment_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "change_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "session_id": {
          "type": "string"
        },
        "window_id": {
          "type": "string"
        },
        "page_numbers": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "artifact_id": {
          "type": "string"
        },
        "revision_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "insertion": {
          "type": "object",
          "additionalProperties": true
        },
        "style_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op_id",
        "capability_id",
        "selector",
        "args"
      ],
      "properties": {
        "op_id": {
          "type": "string"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "capability_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]+$"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "args": {
          "type": "object",
          "additionalProperties": true
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "postconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "on_failure": {
          "enum": [
            "abort",
            "skip_if_precondition",
            "best_effort"
          ]
        },
        "client_label": {
          "type": "string"
        }
      }
    }
  }
}
