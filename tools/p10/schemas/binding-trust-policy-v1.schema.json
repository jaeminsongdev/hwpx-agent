{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwpx-agent.local/schemas/p10/binding-trust-policy-v1.schema.json",
  "title": "P10BindingTrustPolicyV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trust_anchor_id",
    "algorithm",
    "key_id",
    "public_key",
    "target",
    "source_projection",
    "scope",
    "lineage"
  ],
  "properties": {
    "schema_version": { "const": "hwpx-agent.p10-06-binding-trust-policy/v1" },
    "trust_anchor_id": { "const": "p10-current-pc-local-ed25519" },
    "algorithm": { "const": "Ed25519" },
    "key_id": {
      "type": "string",
      "pattern": "^ed25519-sha256-[0-9a-f]{64}$"
    },
    "public_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256"],
      "properties": {
        "relative_path": {
          "const": "implementation/p10/trust/p10-current-pc-local-ed25519-public.pem"
        },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "product_build",
        "locale",
        "process_architecture",
        "executable_sha256"
      ],
      "properties": {
        "profile_id": { "const": "hancom-hangul-2020-secondary" },
        "product_build": { "const": "11.0.0.9136" },
        "locale": { "const": "ko-KR" },
        "process_architecture": { "const": "x86" },
        "executable_sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "source_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p02_trust_anchor_id",
        "p02_public_key_sha256",
        "p02_signed_registry_sha256",
        "p02_payload_sha256",
        "source_registry_sha256",
        "capability_registry_relative_path",
        "capability_registry_sha256"
      ],
      "properties": {
        "p02_trust_anchor_id": { "const": "p02-current-pc-local-ed25519" },
        "p02_public_key_sha256": { "$ref": "#/$defs/hash" },
        "p02_signed_registry_sha256": { "$ref": "#/$defs/hash" },
        "p02_payload_sha256": { "$ref": "#/$defs/hash" },
        "source_registry_sha256": { "$ref": "#/$defs/hash" },
        "capability_registry_relative_path": {
          "const": "specs/capability-contracts.generated.json"
        },
        "capability_registry_sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "use",
        "host",
        "private_key_custody",
        "production_allowed",
        "provider_allowed",
        "hosted_or_vm_allowed",
        "distribution_allowed"
      ],
      "properties": {
        "use": { "const": "personal_noncommercial_local_development" },
        "host": { "const": "current_pc_exact_identity_only" },
        "private_key_custody": { "const": "git_ignored_local_evidence" },
        "production_allowed": { "const": false },
        "provider_allowed": { "const": false },
        "hosted_or_vm_allowed": { "const": false },
        "distribution_allowed": { "const": false }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_bundle_sequence", "rollback_allowed"],
      "properties": {
        "minimum_bundle_sequence": { "const": 1 },
        "rollback_allowed": { "const": false }
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
