{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwpx-agent.local/schemas/p10/runtime-probe-policy-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "target", "capability_registry", "pinned_evidence", "security_module", "admission", "isolation_policy", "scope"],
  "properties": {
    "schema_version": { "const": "hwpx-agent.p10-10-runtime-probe-policy/v1" },
    "policy_id": { "$ref": "#/$defs/semanticId" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "product_build", "locale", "process_architecture", "executable_path", "executable_sha256", "host_baseline_sha256", "prog_id", "clsid", "registry_view"],
      "properties": {
        "profile_id": { "type": "string", "minLength": 3, "maxLength": 128 },
        "product_build": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){3}$" },
        "locale": { "const": "ko-KR" },
        "process_architecture": { "const": "x86" },
        "executable_path": { "type": "string", "pattern": "^[A-Za-z]:\\\\", "maxLength": 1024 },
        "executable_sha256": { "$ref": "#/$defs/hash" },
        "host_baseline_sha256": { "$ref": "#/$defs/hash" },
        "prog_id": { "const": "HWPFrame.HwpObject.2" },
        "clsid": { "type": "string", "pattern": "^\\{[0-9A-Fa-f-]{36}\\}$" },
        "registry_view": { "const": "Registry32" }
      }
    },
    "capability_registry": { "$ref": "#/$defs/pinnedFile" },
    "pinned_evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability_id", "relative_path", "sha256", "required_for_lease"],
        "properties": {
          "capability_id": { "$ref": "#/$defs/semanticId" },
          "relative_path": { "$ref": "#/$defs/relativePath" },
          "sha256": { "$ref": "#/$defs/hash" },
          "required_for_lease": { "const": true }
        }
      }
    },
    "security_module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_for_lease", "state", "registration_name", "sha256"],
      "properties": {
        "required_for_lease": { "const": true },
        "state": { "enum": ["not_configured", "pinned"] },
        "registration_name": { "type": ["string", "null"], "maxLength": 64 },
        "sha256": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_artifact_id", "maximum_probe_age_seconds", "maximum_evidence_bytes", "report_before_acquire_lease", "accepted_and_routable_required", "unroutable_probe_acquires_lease"],
      "properties": {
        "evidence_artifact_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
        "maximum_probe_age_seconds": { "type": "integer", "minimum": 30, "maximum": 86400 },
        "maximum_evidence_bytes": { "type": "integer", "minimum": 1024, "maximum": 1048576 },
        "report_before_acquire_lease": { "const": true },
        "accepted_and_routable_required": { "const": true },
        "unroutable_probe_acquires_lease": { "const": false }
      }
    },
    "isolation_policy": { "$ref": "#/$defs/pinnedFile" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_pc_local_development_only", "production_or_provider_qualified", "another_hancom_version_requires_independent_evidence", "another_host_requires_independent_evidence", "user_document_scan_allowed", "external_network_allowed", "system_setting_change_allowed"],
      "properties": {
        "current_pc_local_development_only": { "const": true },
        "production_or_provider_qualified": { "const": false },
        "another_hancom_version_requires_independent_evidence": { "const": true },
        "another_host_requires_independent_evidence": { "const": true },
        "user_document_scan_allowed": { "const": false },
        "external_network_allowed": { "const": false },
        "system_setting_change_allowed": { "const": false }
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "semanticId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9_-]+)+$" },
    "relativePath": { "type": "string", "pattern": "^(?![A-Za-z]:|[/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$", "maxLength": 1024 },
    "pinnedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256"],
      "properties": {
        "relative_path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
