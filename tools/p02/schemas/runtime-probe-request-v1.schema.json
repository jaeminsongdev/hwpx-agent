{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwpx-agent.local/schemas/private/runtime-probe-request-v1.schema.json",
  "title": "RuntimeProbeRequestV1",
  "description": "Restricted exact-target probe request. Raw automation identifiers may exist only in this private artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "restricted_derivative",
    "registry_sha256",
    "profile_sha256",
    "contracts_sha256",
    "target",
    "fixture",
    "policy",
    "probes",
    "coverage"
  ],
  "properties": {
    "schema_version": { "const": "hwpx-agent.runtime-probe-request/v1" },
    "request_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "restricted_derivative": { "const": true },
    "registry_sha256": { "$ref": "#/$defs/sha256" },
    "profile_sha256": { "$ref": "#/$defs/sha256" },
    "contracts_sha256": { "$ref": "#/$defs/sha256" },
    "target": { "$ref": "#/$defs/target" },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id",
        "kind",
        "source_document_open_allowed",
        "publication"
      ],
      "properties": {
        "fixture_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "kind": { "const": "generated_disposable_hwpx" },
        "source_document_open_allowed": { "const": false },
        "publication": { "const": "private_no_overwrite" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_seconds",
        "preexisting_hwp_process_policy",
        "unexpected_window_policy",
        "cleanup_policy",
        "raw_output_policy",
        "execution_allowlist",
        "default_read_allowlist"
      ],
      "properties": {
        "timeout_seconds": { "type": "integer", "minimum": 30, "maximum": 300 },
        "preexisting_hwp_process_policy": { "const": "refuse" },
        "unexpected_window_policy": { "const": "unverified_and_stop" },
        "cleanup_policy": { "const": "exact_session_identity_only" },
        "raw_output_policy": {
          "const": "private_request_only_hash_public_receipt"
        },
        "execution_allowlist": {
          "type": "array",
          "const": ["edit.undo", "edit.redo"]
        },
        "default_read_allowlist": {
          "type": "array",
          "const": ["edit.go_to"]
        }
      }
    },
    "probes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/probe" }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_count",
        "safe_canary_count",
        "default_read_count",
        "blocked_by_risk_count",
        "planned_not_run_count"
      ],
      "properties": {
        "candidate_count": { "type": "integer", "minimum": 1 },
        "safe_canary_count": { "const": 2 },
        "default_read_count": { "const": 1 },
        "blocked_by_risk_count": { "type": "integer", "minimum": 1 },
        "planned_not_run_count": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "product",
        "major_release",
        "exact_build",
        "locale",
        "architecture",
        "prog_id",
        "registry_view",
        "client_apartment_state",
        "expected_executable_sha256"
      ],
      "properties": {
        "profile_id": { "const": "hancom-hangul-2020-secondary" },
        "product": { "const": "Hancom Hangul 2020" },
        "major_release": { "const": "2020" },
        "exact_build": { "const": "11.0.0.9136" },
        "locale": { "const": "ko-KR" },
        "architecture": { "const": "x86" },
        "prog_id": { "const": "HWPFrame.HwpObject.2" },
        "registry_view": { "const": "Registry32" },
        "client_apartment_state": { "const": "STA" },
        "expected_executable_sha256": {
          "const": "7f00961398802c41620f5ef32fa2d2a26f7ff71f172723be36c660ea86a72bce"
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_key",
        "feature_id",
        "capability_id",
        "scope_class",
        "risk",
        "mutability",
        "action_id",
        "parameter_set_id",
        "parameter_set_state",
        "default_read_planned",
        "execution_plan",
        "planned_disposition",
        "reason_code",
        "expected_effect"
      ],
      "properties": {
        "binding_key": { "type": "string", "minLength": 3, "maxLength": 512 },
        "feature_id": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" },
        "capability_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+$" },
        "scope_class": { "type": "string", "minLength": 1, "maxLength": 128 },
        "risk": { "enum": ["low", "medium", "high", "critical"] },
        "mutability": {
          "enum": [
            "read_only",
            "session_mutation",
            "artifact_mutation",
            "external_side_effect"
          ]
        },
        "action_id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "parameter_set_id": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 512
        },
        "parameter_set_state": {
          "enum": ["documented_candidate", "source_declares_none"]
        },
        "default_read_planned": { "type": "boolean" },
        "execution_plan": {
          "enum": ["safe_canary", "not_run", "blocked_by_risk"]
        },
        "planned_disposition": { "enum": ["blocked_by_risk", "not_run"] },
        "reason_code": {
          "enum": [
            "safe_disposable_undo_redo_canary",
            "safe_default_read_only",
            "high_risk",
            "external_or_security_scope",
            "modal_or_workstation_state_risk",
            "clipboard_side_effect_risk",
            "not_in_bounded_canary_allowlist"
          ]
        },
        "expected_effect": {
          "enum": ["fixture_removed", "fixture_restored", "none"]
        }
      }
    }
  }
}
