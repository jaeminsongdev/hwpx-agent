{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwpx-agent.local/schemas/internal/candidate-graph-v1.schema.json",
  "title": "CandidateGraphV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_lock_id",
    "generator",
    "restricted_derivative",
    "inputs",
    "nodes",
    "edges",
    "coverage"
  ],
  "properties": {
    "schema_version": { "const": "hwpx-agent.candidate-graph/v1" },
    "source_lock_id": { "type": "string", "minLength": 3, "maxLength": 192 },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator_id", "generator_version", "auto_merge"],
      "properties": {
        "generator_id": { "const": "source-record-candidate-generator" },
        "generator_version": { "const": "0.1.0" },
        "auto_merge": { "const": false }
      }
    },
    "restricted_derivative": { "type": "boolean" },
    "inputs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "input_sha256",
          "record_count",
          "source_ids",
          "license_states"
        ],
        "properties": {
          "role": { "enum": ["automation", "help", "owpml"] },
          "input_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "record_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 3, "maxLength": 192 }
          },
          "license_states": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": { "enum": ["public_reference", "restricted"] }
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "maxItems": 1000000,
      "items": { "$ref": "#/$defs/edge" }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_record_count",
        "node_count",
        "edge_count",
        "normalized_label_count",
        "singleton_node_count",
        "review_candidate_count",
        "collision_review_count",
        "auto_merge_count"
      ],
      "properties": {
        "input_record_count": { "type": "integer", "minimum": 1 },
        "node_count": { "type": "integer", "minimum": 1 },
        "edge_count": { "type": "integer", "minimum": 0 },
        "normalized_label_count": { "type": "integer", "minimum": 1 },
        "singleton_node_count": { "type": "integer", "minimum": 0 },
        "review_candidate_count": { "type": "integer", "minimum": 0 },
        "collision_review_count": { "type": "integer", "minimum": 0 },
        "auto_merge_count": { "const": 0 }
      }
    }
  },
  "$defs": {
    "ioSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "confidence", "inputs", "outputs", "unknowns"],
      "properties": {
        "domain": { "enum": ["none", "callable", "field", "entity"] },
        "confidence": { "enum": ["none", "indirect", "direct"] },
        "inputs": {
          "type": "array",
          "maxItems": 512,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "outputs": {
          "type": "array",
          "maxItems": 512,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "unknowns": {
          "type": "array",
          "maxItems": 512,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "input_role",
        "input_sha256",
        "input_ordinal",
        "record_id",
        "source_id",
        "source_sha256",
        "source_kind",
        "normalized_label",
        "label_tokens",
        "io_signature",
        "availability_digest",
        "target_scope"
      ],
      "properties": {
        "node_id": { "type": "string", "pattern": "^node:[0-9a-f]{24}$" },
        "input_role": { "enum": ["automation", "help", "owpml"] },
        "input_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "input_ordinal": { "type": "integer", "minimum": 0 },
        "record_id": { "type": "string", "minLength": 3, "maxLength": 192 },
        "source_id": { "type": "string", "minLength": 3, "maxLength": 192 },
        "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "source_kind": {
          "enum": [
            "help",
            "webhwp",
            "xsd",
            "action_table",
            "parameter_table",
            "automation_object",
            "automation_event"
          ]
        },
        "normalized_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "label_tokens": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "io_signature": { "$ref": "#/$defs/ioSignature" },
        "availability_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "target_scope": { "type": ["string", "null"], "maxLength": 1024 }
      }
    },
    "matchState": { "enum": ["exact", "unknown_compatible", "conflict"] },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "left_node_id",
        "right_node_id",
        "normalized_label",
        "candidate_state",
        "input_match",
        "output_match",
        "scope_match",
        "reasons",
        "auto_merge"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^candidate:[0-9a-f]{24}$"
        },
        "left_node_id": { "type": "string", "pattern": "^node:[0-9a-f]{24}$" },
        "right_node_id": { "type": "string", "pattern": "^node:[0-9a-f]{24}$" },
        "normalized_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "candidate_state": { "enum": ["review_candidate", "collision_review"] },
        "input_match": { "$ref": "#/$defs/matchState" },
        "output_match": { "$ref": "#/$defs/matchState" },
        "scope_match": { "$ref": "#/$defs/matchState" },
        "reasons": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "auto_merge": { "const": false }
      }
    }
  }
}
