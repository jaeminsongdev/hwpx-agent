{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwpx-agent.local/schemas/p02/registry-drift-v1.schema.json",
  "title": "RegistryDriftV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state",
    "baseline_state",
    "baseline",
    "current",
    "summary",
    "changes",
    "policy"
  ],
  "properties": {
    "schema_version": { "const": "hwpx-agent.registry-drift/v1" },
    "state": { "enum": ["pass", "failed"] },
    "baseline_state": { "enum": ["available", "baseline_unavailable"] },
    "baseline": {
      "oneOf": [{ "$ref": "#/$defs/registryIdentity" }, { "type": "null" }]
    },
    "current": { "$ref": "#/$defs/registryIdentity" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compared_capability_count",
        "added_count",
        "removed_count",
        "binding_changed_count",
        "parameter_changed_count",
        "behavior_changed_count",
        "unchanged_count",
        "unverified_for_build_count"
      ],
      "properties": {
        "compared_capability_count": { "type": "integer", "minimum": 0 },
        "added_count": { "type": "integer", "minimum": 0 },
        "removed_count": { "type": "integer", "minimum": 0 },
        "binding_changed_count": { "type": "integer", "minimum": 0 },
        "parameter_changed_count": { "type": "integer", "minimum": 0 },
        "behavior_changed_count": { "type": "integer", "minimum": 0 },
        "unchanged_count": { "type": "integer", "minimum": 0 },
        "unverified_for_build_count": { "type": "integer", "minimum": 0 }
      }
    },
    "changes": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability_id", "change_types", "support_state"],
        "properties": {
          "capability_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]+$"
          },
          "change_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "added",
                "removed",
                "binding_changed",
                "parameter_changed",
                "behavior_changed"
              ]
            }
          },
          "support_state": { "const": "unverified_for_build" }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed_bindings_auto_promoted",
        "production_route_changed",
        "raw_identifiers_present"
      ],
      "properties": {
        "changed_bindings_auto_promoted": { "const": false },
        "production_route_changed": { "const": false },
        "raw_identifiers_present": { "const": false }
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "registryIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "exact_build",
        "source_registry_sha256",
        "payload_sha256",
        "key_id",
        "registry_sequence"
      ],
      "properties": {
        "profile_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "exact_build": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$"
        },
        "source_registry_sha256": { "$ref": "#/$defs/hash" },
        "payload_sha256": { "$ref": "#/$defs/hash" },
        "key_id": {
          "type": "string",
          "pattern": "^ed25519-sha256-[0-9a-f]{64}$"
        },
        "registry_sequence": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
