{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwpx-agent.local/schemas/catalog/source-record-v1.schema.json",
  "title": "SourceRecordV1",
  "description": "Immutable normalized metadata for one item extracted from an official or runtime-qualification source.",
  "x-rust-model": true,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "source_lock_id",
    "source_id",
    "source_sha256",
    "source_kind",
    "locator",
    "original_name",
    "description_ko",
    "parameters",
    "availability",
    "extraction"
  ],
  "properties": {
    "schema_version": { "const": "hwpx-agent.source-record/v1" },
    "record_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{2,191}$"
    },
    "source_lock_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,191}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,191}$"
    },
    "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_kind": {
      "enum": [
        "help",
        "pdf",
        "xsd",
        "action_table",
        "parameter_table",
        "automation_object",
        "automation_event",
        "webhwp",
        "runtime"
      ]
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": [
            "page",
            "section",
            "anchor",
            "xpath",
            "xsd_component",
            "automation_item",
            "runtime_probe"
          ]
        },
        "page": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "value": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "section": { "type": "string", "minLength": 1, "maxLength": 512 },
        "anchor": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "page" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["page"],
            "not": { "required": ["value"] }
          },
          "else": {
            "required": ["value"],
            "not": { "required": ["page"] }
          }
        }
      ]
    },
    "original_name": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "description_ko": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 20000
    },
    "parameters": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "original_name",
          "declared_type",
          "direction",
          "required",
          "description_ko"
        ],
        "properties": {
          "ordinal": { "type": "integer", "minimum": 0, "maximum": 511 },
          "original_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "declared_type": { "type": ["string", "null"], "maxLength": 512 },
          "direction": { "enum": ["in", "out", "inout", "unknown"] },
          "required": { "type": ["boolean", "null"] },
          "description_ko": { "type": ["string", "null"], "maxLength": 10000 }
        }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "target_profile_id",
        "minimum_version",
        "maximum_version",
        "locales",
        "support_scope"
      ],
      "properties": {
        "product": { "enum": ["hancom_hangul", "webhwp"] },
        "target_profile_id": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "minimum_version": {
          "type": ["string", "null"],
          "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$"
        },
        "maximum_version": {
          "type": ["string", "null"],
          "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$"
        },
        "locales": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$" }
        },
        "support_scope": {
          "enum": [
            "documentation_only",
            "current_pc_candidate",
            "runtime_observed"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "support_scope": { "const": "runtime_observed" } },
            "required": ["support_scope"]
          },
          "then": {
            "properties": {
              "target_profile_id": { "type": "string" },
              "minimum_version": { "type": "string" },
              "maximum_version": { "type": "string" }
            }
          }
        }
      ]
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extractor_id", "extractor_version", "record_ordinal"],
      "properties": {
        "extractor_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "extractor_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "record_ordinal": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "source_kind": { "enum": ["help", "webhwp"] } },
        "required": ["source_kind"]
      },
      "then": {
        "properties": {
          "locator": {
            "properties": {
              "kind": { "enum": ["page", "section", "anchor"] }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "source_kind": { "const": "pdf" } },
        "required": ["source_kind"]
      },
      "then": {
        "properties": {
          "locator": {
            "properties": {
              "kind": { "enum": ["page", "section", "anchor"] }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "source_kind": { "const": "xsd" } },
        "required": ["source_kind"]
      },
      "then": {
        "properties": {
          "locator": {
            "properties": {
              "kind": { "enum": ["xpath", "xsd_component"] }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_kind": {
            "enum": [
              "action_table",
              "parameter_table",
              "automation_object",
              "automation_event"
            ]
          }
        },
        "required": ["source_kind"]
      },
      "then": {
        "properties": {
          "locator": {
            "properties": {
              "kind": { "const": "automation_item" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "source_kind": { "const": "runtime" } },
        "required": ["source_kind"]
      },
      "then": {
        "properties": {
          "locator": {
            "properties": {
              "kind": { "const": "runtime_probe" }
            }
          }
        }
      }
    }
  ]
}
