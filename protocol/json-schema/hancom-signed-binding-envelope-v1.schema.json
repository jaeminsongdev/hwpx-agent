{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwpx-agent.local/schemas/windows/hancom-signed-binding-envelope-v1.schema.json",
  "title": "HancomSignedBindingEnvelopeV1",
  "description": "Private exact-target Ed25519 execution authorization. The signature covers the exact decoded payload bytes.",
  "x-catalog-version": 4,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "algorithm",
    "key_id",
    "public_key_sha256",
    "payload_sha256",
    "payload_base64",
    "signature_base64"
  ],
  "properties": {
    "schema_version": {
      "const": "hwpx-agent.p10-06-signed-binding-envelope/v1"
    },
    "algorithm": { "const": "Ed25519" },
    "key_id": {
      "type": "string",
      "pattern": "^ed25519-sha256-[0-9a-f]{64}$"
    },
    "public_key_sha256": { "$ref": "#/$defs/hash" },
    "payload_sha256": { "$ref": "#/$defs/hash" },
    "payload_base64": {
      "type": "string",
      "minLength": 4,
      "maxLength": 699052,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "signature_base64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
