{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwpx-agent.local/schemas/windows/hancom-binding-bundle-v1.schema.json",
  "title": "HancomBindingBundleV1",
  "description": "Decoded private P10 execution payload. Raw Action and ParameterSet identifiers must never cross the public protocol or safe-log boundary.",
  "x-catalog-version": 4,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "sequence",
    "source_registry_sha256",
    "capability_registry_sha256",
    "target",
    "authorization",
    "bindings"
  ],
  "properties": {
    "schema_version": { "const": "hwpx-agent.p10-06-binding-bundle/v1" },
    "bundle_id": { "$ref": "#/$defs/semanticId" },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
    "source_registry_sha256": { "$ref": "#/$defs/hash" },
    "capability_registry_sha256": { "$ref": "#/$defs/hash" },
    "target": { "$ref": "#/$defs/target" },
    "authorization": { "$ref": "#/$defs/authorization" },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/binding" }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "semanticId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9_-]+)+$",
      "not": { "pattern": "(?:haction|parameterset)" }
    },
    "privateIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "product_build",
        "locale",
        "process_architecture",
        "executable_sha256"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "product_build": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+){3}$"
        },
        "locale": { "type": "string", "pattern": "^[a-z]{2,3}-[A-Z]{2}$" },
        "process_architecture": { "enum": ["x86", "x64", "arm64"] },
        "executable_sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_enabled",
        "source_registry_routing_enabled",
        "scope",
        "minimum_probe_state"
      ],
      "properties": {
        "execution_enabled": { "const": true },
        "source_registry_routing_enabled": { "const": false },
        "scope": { "const": "current_pc_exact_target_only" },
        "minimum_probe_state": { "const": "runtime_verified_current_target" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "action_id",
        "parameter_set_id",
        "probe_evidence_sha256",
        "target_mode",
        "parameters"
      ],
      "properties": {
        "capability_id": { "$ref": "#/$defs/semanticId" },
        "action_id": { "$ref": "#/$defs/privateIdentifier" },
        "parameter_set_id": {
          "oneOf": [{ "$ref": "#/$defs/privateIdentifier" }, { "type": "null" }]
        },
        "probe_evidence_sha256": { "$ref": "#/$defs/hash" },
        "target_mode": { "const": "document_global" },
        "parameters": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/parameter" }
        }
      },
      "allOf": [
        {
          "anyOf": [
            {
              "properties": {
                "parameter_set_id": { "type": "null" },
                "parameters": { "maxItems": 0 }
              }
            },
            {
              "properties": {
                "parameter_set_id": { "$ref": "#/$defs/privateIdentifier" },
                "parameters": { "minItems": 1 }
              }
            }
          ]
        }
      ]
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argument_id",
        "item_name",
        "source_value_type",
        "target_value_type",
        "required",
        "minimum",
        "maximum",
        "maximum_utf8_bytes",
        "scale_numerator",
        "scale_denominator",
        "rounding",
        "enum_values"
      ],
      "properties": {
        "argument_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "item_name": { "$ref": "#/$defs/privateIdentifier" },
        "source_value_type": {
          "enum": [
            "text",
            "boolean",
            "integer",
            "length_micrometers",
            "point_milli",
            "ratio_millionths",
            "angle_microdegrees"
          ]
        },
        "target_value_type": {
          "enum": ["string", "boolean", "int32", "int32_enum"]
        },
        "required": { "type": "boolean" },
        "minimum": {
          "type": ["integer", "null"],
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "maximum": {
          "type": ["integer", "null"],
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "maximum_utf8_bytes": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 65536
        },
        "scale_numerator": {
          "type": ["integer", "null"],
          "minimum": -1000000000,
          "maximum": 1000000000
        },
        "scale_denominator": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 1000000000
        },
        "rounding": {
          "type": ["string", "null"],
          "enum": ["exact", "half_away_from_zero", null]
        },
        "enum_values": {
          "oneOf": [
            {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 256,
              "propertyNames": { "pattern": "^[A-Za-z0-9_.-]{1,128}$" },
              "additionalProperties": {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              }
            },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "anyOf": [
            {
              "properties": {
                "source_value_type": { "const": "text" },
                "target_value_type": { "const": "string" },
                "minimum": { "type": "null" },
                "maximum": { "type": "null" },
                "maximum_utf8_bytes": { "type": "integer" },
                "scale_numerator": { "type": "null" },
                "scale_denominator": { "type": "null" },
                "rounding": { "type": "null" },
                "enum_values": { "type": "null" }
              }
            },
            {
              "properties": {
                "source_value_type": { "const": "text" },
                "target_value_type": { "const": "int32_enum" },
                "minimum": { "type": "null" },
                "maximum": { "type": "null" },
                "maximum_utf8_bytes": { "type": "integer" },
                "scale_numerator": { "type": "null" },
                "scale_denominator": { "type": "null" },
                "rounding": { "type": "null" },
                "enum_values": { "type": "object" }
              }
            },
            {
              "properties": {
                "source_value_type": { "const": "boolean" },
                "target_value_type": { "const": "boolean" },
                "minimum": { "type": "null" },
                "maximum": { "type": "null" },
                "maximum_utf8_bytes": { "type": "null" },
                "scale_numerator": { "type": "null" },
                "scale_denominator": { "type": "null" },
                "rounding": { "type": "null" },
                "enum_values": { "type": "null" }
              }
            },
            {
              "properties": {
                "source_value_type": {
                  "enum": [
                    "integer",
                    "length_micrometers",
                    "point_milli",
                    "ratio_millionths",
                    "angle_microdegrees"
                  ]
                },
                "target_value_type": { "const": "int32" },
                "minimum": { "type": "integer" },
                "maximum": { "type": "integer" },
                "maximum_utf8_bytes": { "type": "null" },
                "scale_numerator": {
                  "type": "integer",
                  "not": { "const": 0 }
                },
                "scale_denominator": { "type": "integer" },
                "rounding": { "enum": ["exact", "half_away_from_zero"] },
                "enum_values": { "type": "null" }
              }
            }
          ]
        }
      ]
    }
  }
}
