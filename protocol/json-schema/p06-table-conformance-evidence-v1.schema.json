{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwpx-agent.local/schemas/p06-table-conformance-evidence-v1.schema.json",
  "title": "P06TableConformanceEvidenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target",
    "required_fixture_classes",
    "records",
    "not_claimed"
  ],
  "properties": {
    "schema_version": { "const": "hwpx-agent.table-conformance-evidence/v1" },
    "target": { "$ref": "p06-table-automation-projection-v1.schema.json#/$defs/target" },
    "required_fixture_classes": {
      "const": ["happy_path", "boundary", "negative", "preservation", "target_build", "security"]
    },
    "records": {
      "type": "array",
      "maxItems": 61,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feature_ids",
          "backend",
          "stage",
          "validations_passed",
          "fixture_classes_passed",
          "negative_passed",
          "rollback_or_retry_passed",
          "differential_state",
          "evidence_files"
        ],
        "properties": {
          "feature_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "p06-table-automation-projection-v1.schema.json#/$defs/featureId" }
          },
          "backend": { "enum": ["component_only", "direct_hwpx"] },
          "stage": { "enum": ["unit_passed", "integration_passed", "oracle_verified"] },
          "validations_passed": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 128 }
          },
          "fixture_classes_passed": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": ["happy_path", "boundary", "negative", "preservation", "target_build", "security"]
            }
          },
          "negative_passed": { "type": "boolean" },
          "rollback_or_retry_passed": { "type": "boolean" },
          "differential_state": { "enum": ["not_run", "exact_match", "mismatch"] },
          "evidence_files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": { "type": "string", "minLength": 1, "maxLength": 512 },
                "sha256": { "$ref": "p06-table-automation-projection-v1.schema.json#/$defs/sha256" }
              }
            }
          }
        }
      }
    },
    "not_claimed": {
      "const": {
        "p06_07_renderer_gate": false,
        "p06_09_complete": false,
        "p06_phase_complete": false,
        "production": false,
        "other_pc_or_version": false,
        "product_complete": false
      }
    }
  }
}
