{
  "schema_version": "hwpx-agent.p17-atomic-mirror-checkpoint/v1",
  "scope": "current_pc_atomic_durable_mirror_admission_and_checkpoint_only",
  "database": {
    "engine": "PostgreSQL",
    "required_schema_versions": "exact_contiguous_1_through_15",
    "latest_migration": "p17.atomic_mirror_checkpoint_v3",
    "transaction_isolation": "serializable",
    "function": "hwpx_agent.create_mirror_history_checkpoint_v3",
    "role": {
      "superuser": false,
      "bypass_rls": false,
      "schema_create": false,
      "table_write_or_trigger_privileges": false,
      "legacy_checkpoint_execute": false,
      "v2_checkpoint_execute": false,
      "v3_atomic_checkpoint_execute": true,
      "owner_role_membership": false
    },
    "row_security": {
      "enabled": true,
      "forced": true,
      "single_policy": "tenant_isolation",
      "tables": [
        "projects",
        "project_acl",
        "branches",
        "project_local_mirrors",
        "revisions",
        "revision_graph_seals",
        "history_checkpoint_requests",
        "checkpoints",
        "audit_events"
      ]
    }
  },
  "admission": {
    "tenant_and_subject": "transaction_local_authenticated_context",
    "project": "exact_active_project",
    "role": "durable_editor_or_owner_row_locked_for_share",
    "mirror": "exact_project_branch_and_mirror_row_locked_for_share",
    "mirror_state": "clean_with_no_pending_plan_or_active_push",
    "head": "durable_branch_head_row_locked_for_share",
    "expected_state": "same_nonzero_revision_and_positive_generation_for_mirror_branch_and_checkpoint",
    "checkpoint": "immutable_v2_create_or_exact_replay_before_same_transaction_commit",
    "drift": "P1702_rejected_without_checkpoint_rows",
    "retry_after_uncertain_outcome": false
  },
  "rollback": {
    "explicit_setting": "hwpx_agent.allow_p17_atomic_mirror_checkpoint_rollback=yes",
    "exact_version_15_required": true,
    "later_versions_forbidden": true,
    "data_columns_removed": false
  },
  "transport": {
    "address": "127.0.0.1",
    "listener_and_client_processes": "separate",
    "client_process_count": 7,
    "tls": false,
    "remote_network": false
  },
  "diagnostics": {
    "backend_error_text_retained": false,
    "password_debug": "redacted",
    "tenant_subject_and_client_debug": "redacted",
    "definite_input_acl_fk_unique_or_state_failure": "rejected",
    "serialization_transport_or_unknown_failure": "unavailable"
  },
  "evidence_boundary": {
    "actual_current_pc_disposable_postgresql": true,
    "actual_separate_host_process": true,
    "actual_separate_client_processes": 7,
    "actual_atomic_mirror_admission_and_checkpoint": true,
    "durable_retention_mirror_admission": true,
    "actual_role_drift_rejection": true,
    "actual_head_drift_rejection": true,
    "actual_mirror_state_drift_rejection": true,
    "actual_pull_or_push": false,
    "persistent_credential_custody": false,
    "actual_hangul": false,
    "production": false,
    "p17_06_complete": false
  }
}
