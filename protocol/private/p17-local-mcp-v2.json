      "name": "local_companion_health",
      "method": "health",
      "input_fields": [],
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "local_companion_materialize",
      "method": "materialize",
      "input_fields": [
        "workspace_id",
        "operation_id",
        "slot",
        "fixture_id",
        "expected_sha256"
      ],
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "local_companion_diff",
      "method": "diff",
      "input_fields": [
        "workspace_id",
        "operation_id"
