      "returns_document_content": false,
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "local_companion_publish",
      "method": "publish",
      "input_fields": [
        "workspace_id",
        "operation_id",
        "output_id",
        "expected_sha256"
      ],
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "local_companion_prepare_git_commit",
      "method": "prepare_git_commit",
      "input_fields": [
        "workspace_id",
        "output_id",
        "expected_sha256",
        "message"
