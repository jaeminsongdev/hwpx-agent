{
  "schema_version": "hwpx-agent.windows-credential-custody-contract/v1",
  "scope": "current_pc_windows_credential_manager_retrieval_component",
  "platform": {
    "operating_system": "Windows",
    "store": "Windows Credential Manager",
    "credential_type": "generic",
    "persistence": "local_machine_current_user_until_delete",
    "maximum_secret_bytes": 2560
  },
  "dependencies": {
    "keyring_core": "1.0.0",
    "windows_native_keyring_store": "1.1.0",
    "default_features": false,
    "target_dependency": "cfg(windows)"
  },
  "locator": {
    "service_and_account_are_opaque_non_secret_identifiers": true,
    "maximum_bytes_each": 120,
    "allowed_ascii": "A-Z a-z 0-9 . _ -",
    "target_template": "hwpx-agent.remote-sync:{account}:{service}",
    "target_is_debug_redacted": true,
    "credential_enumeration": false
  },
  "retrieval": {
    "product_write_or_delete_api": false,
    "credential_contains": "jwt_body_without_bearer_prefix",
    "authorization_header_is_reconstructed_in_zeroizing_memory": true,
    "retrieved_and_malformed_secret_bytes_are_zeroized": true,
    "provider_attempts_per_instance": 1,
    "unavailable_and_rejected_are_distinct": true,
    "debug_discloses_secret_or_locator": false
  },
  "implementation_files": [
    "Cargo.toml",
    "Cargo.lock",
    "crates/local-sync/src/adapter.rs",
    "crates/windows-credential-custody/Cargo.toml",
    "crates/windows-credential-custody/src/lib.rs",
    "crates/windows-credential-custody/tests/windows_credential_custody.rs",
    "implementation/p17/P17-06_WINDOWS_CREDENTIAL_CUSTODY_V18.md",
    "implementation/p17/evidence/credential-custody/p17-windows-credential-custody.current-20260911.v1.json",
    "protocol/migrations/p17-windows-credential-custody-v1.md",
    "tools/p17/tests/test_windows_credential_custody_contract.py",
    "tools/p17/validate_windows_credential_custody_contract.py"
  ],
  "evidence": {
    "path": "implementation/p17/evidence/credential-custody/p17-windows-credential-custody.current-20260911.v1.json",
    "exact_current_pc_synthetic_qualification": true,
    "routine_workspace_test_is_ignored": true,
    "explicit_qualification_test_passed": true,
    "owned_credential_cleaned": true
  },
  "failure_policy": [
    "invalid_or_oversized_locator_rejected",
    "missing_or_inaccessible_store_unavailable",
    "empty_oversized_non_utf8_or_non_jwt_secret_rejected",
    "ambiguous_or_malformed_store_data_rejected",
    "second_provider_attempt_unavailable",
    "qualification_requires_exact_no_entry_before_and_after",
    "contract_evidence_or_dependency_drift_rejected"
  ],
  "external_authorities": [
    {
      "authority": "Microsoft CREDENTIALW",
      "url": "https://learn.microsoft.com/en-us/windows/win32/api/wincred/ns-wincred-credentialw",
      "facts": [
        "CRED_MAX_CREDENTIAL_BLOB_SIZE_is_5_times_512_bytes",
        "CRED_PERSIST_LOCAL_MACHINE_is_current_user_same_computer_across_logon_sessions"
      ]
    },
    {
      "authority": "windows-native-keyring-store 1.1.0",
      "url": "https://docs.rs/windows-native-keyring-store/1.1.0/windows_native_keyring_store/",
      "facts": [
        "backend_is_Windows_Credential_Manager",
        "generic_credential_and_persistence_modifiers_supported"
      ]
    }
  ],
  "gate_decision": {
    "component": "pass",
    "actual_current_pc_persistent_store_mechanism": true,
    "real_service_credential": false,
    "credential_issuance_or_rotation": false,
    "actual_remote_tls": false,
    "registered_host": false,
    "production": false,
    "p17_06_complete": false,
    "product_complete": false
  }
}
