          },
          "workspace_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "config_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "status",
          "target_profile",
          "automation_enabled",
          "network_enabled",
          "workspace_count",
          "config_sha256"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    }
  ],
  "claims": {
    "opens_hangul": false,
    "reads_document_content": false,
    "accepts_paths": false,
    "uses_network": false,
    "persists_credentials": false
