{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwpx-agent.local/p00/diagnostic-events.schema.json",
  "title": "HancomDiagnosticEvents",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "run_id", "from", "to", "raw_messages_collected", "events"],
  "properties": {
    "schema_version": { "const": "hwpx-agent.hancom-diagnostic-events/v1" },
    "request_id": { "type": "string", "format": "uuid" },
    "run_id": { "type": "string", "format": "uuid" },
    "from": { "type": "string", "format": "date-time" },
    "to": { "type": "string", "format": "date-time" },
    "raw_messages_collected": { "const": false },
    "events": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider_name", "event_id", "level", "time_created", "record_id", "data", "raw_message_collected"],
        "properties": {
          "provider_name": { "enum": ["Application Error", "Application Hang", "Windows Error Reporting", ".NET Runtime", "SideBySide"] },
          "event_id": { "type": "integer" },
          "level": { "type": "string" },
          "time_created": { "type": ["string", "null"], "format": "date-time" },
          "record_id": { "type": "integer" },
          "data": { "type": "object", "additionalProperties": { "type": "string" } },
          "raw_message_collected": { "const": false }
        }
      }
    }
  }
}
