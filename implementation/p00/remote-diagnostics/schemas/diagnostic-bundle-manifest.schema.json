{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwpx-agent.local/p00/diagnostic-bundle-manifest.schema.json",
  "title": "HancomDiagnosticBundleManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "run_id", "entries"],
  "properties": {
    "schema_version": { "const": "hwpx-agent.hancom-diagnostic-bundle-manifest/v1" },
    "request_id": { "type": "string", "format": "uuid" },
    "run_id": { "type": "string", "format": "uuid" },
    "entries": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "enum": ["events.json", "inventory.json", "request.json", "session.json"] },
          "bytes": { "type": "integer", "minimum": 0, "maximum": 5242880 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
