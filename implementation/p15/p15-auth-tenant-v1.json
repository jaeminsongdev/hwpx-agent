    "production_jwks_implemented": false,
    "public_mcp_principal_kind": "user",
    "internal_service_principal_kind": "service",
    "service_tokens_accepted_from_openai_host": false,
    "service_tokens_single_use": true
  },
  "jwt": {
    "local_reference_algorithm": "HS256",
    "user_typ": "at+jwt",
    "service_typ": "hwpx-service+jwt",
    "required_claims": [
      "aud",
      "exp",
      "iat",
      "iss",
      "jti",
      "nbf",
      "scope",
      "sub",
      "tenant_id",
      "token_kind"
    ],
    "unknown_claims_rejected": true,
    "duplicate_claims_rejected": true,
    "multi_audience_rejected": true
  },
  "limits": {
    "bearer_token_bytes": 8192,
    "claims_json_bytes": 4096,
